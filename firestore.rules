rules_version = '2';
// RÈGLES — Phase 3, étape 9 (badge payant à durée, dossier de vérification avec documents ; étape 8 : annonces, J'aime, favoris, profils, abonnements, avis, messagerie, badge de vérification,
// statistiques, administration avec rôles, notifications, confidentialité, INFORMATIONS PERSONNELLES privées,
// INTÉRÊTS et RECOMMANDATIONS de chaque compte).
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Fonctions utiles ─────────
    function signedIn() { return request.auth != null; }

    function userPath(id)   { return /databases/$(database)/documents/users/$(id); }
    function followPath(follower, target) { return /databases/$(database)/documents/follows/$(follower + '_' + target); }
    function reviewPath(target, reviewer) { return /databases/$(database)/documents/reviews/$(target + '_' + reviewer); }

    // Champ facultatif : texte de longueur limitée
    function optStr(f, max) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string && request.resource.data[f].size() <= max);
    }
    // Champ facultatif : vide, ou adresse correspondant au modèle donné
    function optMatch(f, re, max) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is string
            && request.resource.data[f].size() <= max
            && (request.resource.data[f] == '' || request.resource.data[f].matches(re)));
    }
    function likePath(pid, uid) { return /databases/$(database)/documents/properties/$(pid)/likes/$(uid); }
    function propertyPath(pid) { return /databases/$(database)/documents/properties/$(pid); }

    // ───────── Messagerie : fonctions utiles
    function convPath(cid) { return /databases/$(database)/documents/conversations/$(cid); }
    function blockPath(blocker, blocked) { return /databases/$(database)/documents/blocks/$(blocker + '_' + blocked); }
    function isMember(cid) { return signedIn() && request.auth.uid in get(convPath(cid)).data.members; }
    // l'autre participant, calculé sur l'état APRÈS l'écriture (la conversation peut être créée dans le même lot)
    function otherMember(cid) {
      let m = getAfter(convPath(cid)).data.members;
      return m[0] == request.auth.uid ? m[1] : m[0];
    }
    // au moins 0,7 seconde entre deux messages d'un même utilisateur dans une conversation
    function throttleOk(cid) {
      return !exists(convPath(cid))
        || get(convPath(cid)).data.lastSent.get(request.auth.uid, request.time - duration.value(1, 'h')) < request.time - duration.value(700, 'ms');
    }

    function validRating(r) { return r is int && r >= 1 && r <= 5; }

    // ───────── Administration : rôles (documents admins/UID, créés par le propriétaire ou à la main dans la console)
    function adminPath(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function isStaff() { return signedIn() && exists(adminPath(request.auth.uid)); }
    function staffRole() { return get(adminPath(request.auth.uid)).data.role.lower(); }
    function isAdmin() { return isStaff() && staffRole() in ['owner', 'admin']; }
    function isOwnerRole() { return isStaff() && staffRole() == 'owner'; }
    // Confidentialité : qui peut démarrer une conversation avec moi ? (tout le monde, ou seulement les personnes que je suis ;
    // l'équipe d'administration et le support peuvent toujours écrire)
    function canStartWith(other) {
      return get(userPath(other)).data.get('messagesFrom', 'everyone') == 'everyone'
        || exists(followPath(other, request.auth.uid))
        || exists(adminPath(other));
    }
    function validPrefs(p) {
      return p.keys().hasOnly(['personalization', 'readReceipts', 'typingIndicator', 'notif', 'browser', 'updatedAt'])
        && p.get('personalization', true) is bool
        && p.readReceipts is bool && p.typingIndicator is bool
        && p.notif is map && p.notif.keys().hasOnly(['messages', 'follows', 'likes', 'reviews', 'followedPosts'])
        && p.notif.get('messages', true) is bool && p.notif.get('follows', true) is bool && p.notif.get('likes', true) is bool
        && p.notif.get('reviews', true) is bool && p.notif.get('followedPosts', true) is bool
        && p.browser is map && p.browser.keys().hasOnly(['enabled', 'messages', 'activity'])
        && p.browser.get('enabled', false) is bool && p.browser.get('messages', true) is bool && p.browser.get('activity', true) is bool;
    }
    // Âge : au moins 18 ans révolus à la date de la demande (contrôlé par la base, pas seulement par la page)
    function ageOk(b) {
      return request.time.year() - b.year() > 18
        || (request.time.year() - b.year() == 18
            && (request.time.month() > b.month() || (request.time.month() == b.month() && request.time.day() >= b.day())));
    }
    function validPerson(d) {
      return d.firstName is string && d.firstName.size() >= 2 && d.firstName.size() <= 60
        && d.lastName is string && d.lastName.size() >= 2 && d.lastName.size() <= 60
        && d.postName is string && d.postName.size() >= 2 && d.postName.size() <= 60
        && d.gender in ['F', 'M']
        && d.birthDate is timestamp && ageOk(d.birthDate)
        && d.email is string && d.email.size() <= 200
        && d.phone is string && d.phone.size() <= 20
        && (d.email.size() > 0 || d.phone.size() > 0)
        && d.searchKeys is list && d.searchKeys.size() <= 6
        && (d.accountType != 'agence' || (d.agencyName is string && d.agencyName.size() >= 2 && d.agencyName.size() <= 60));
    }
    function validInterests(d) {
      return d.keys().hasOnly(['tokens', 'concepts', 'authors', 'negTokens', 'negAuthors', 'hidden', 'searches', 'preferences', 'signals', 'updatedAt'])
        && d.tokens is map && d.tokens.size() <= 300
        && d.concepts is map && d.concepts.size() <= 60
        && d.authors is map && d.authors.size() <= 150
        && d.negTokens is map && d.negTokens.size() <= 150
        && d.negAuthors is map && d.negAuthors.size() <= 150
        && d.hidden is list && d.hidden.size() <= 400
        && d.searches is list && d.searches.size() <= 40
        && d.preferences is map
        && d.signals is number
        && d.updatedAt == request.time;
    }
    // un compte suspendu ne peut plus publier, écrire, suivre ni noter
    function notSuspended() { return !get(userPath(request.auth.uid)).data.get('suspended', false); }
    function settingsPath() { return /databases/$(database)/documents/platformSettings/main; }
    function publishingOpen() { return !exists(settingsPath()) || get(settingsPath()).data.get('publishingEnabled', true); }
    function verificationOpen() { return !exists(settingsPath()) || get(settingsPath()).data.get('verificationOpen', true); }
    // jour (UTC) au format AAAAMMJJ, pour les événements de statistiques (un par visiteur, élément et jour)
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function dayString(t) { return string(t.year()) + pad2(t.month()) + pad2(t.day()); }
    function eventPath(eid) { return /databases/$(database)/documents/events/$(eid); }
    function cloudUrl(u) { return u is string && u.size() <= 400 && u.matches('https://res\\.cloudinary\\.com/.*'); }
    // Dossier de vérification : pièce d'identité, adresse, et pour une agence le document officiel ou une justification
    function validVerifData(d, t) {
      return d is map
        && d.keys().hasOnly(['idType', 'idUrl', 'idKind', 'idName', 'orgUrl', 'orgKind', 'orgName', 'orgJustification', 'extraDocs', 'address', 'website', 'notes'])
        && d.idType in ['carte_electeur', 'carte_identite', 'passeport', 'permis', 'autre']
        && cloudUrl(d.idUrl)
        && d.idKind in ['image', 'raw']
        && d.get('idName', '').size() <= 200
        && d.get('address', '').size() <= 250
        && d.get('website', '').size() <= 200
        && d.get('notes', '').size() <= 400
        && d.get('orgJustification', '').size() <= 600
        && d.get('orgName', '').size() <= 200
        && (!('orgUrl' in d) || (cloudUrl(d.orgUrl) && d.orgKind in ['image', 'raw']))
        && d.get('extraDocs', []).size() <= 3
        && (t == 'agence'
            ? ((d.get('address', '').size() >= 5 || d.get('website', '').size() >= 4) && ('orgUrl' in d || d.get('orgJustification', '').size() >= 10))
            : d.get('address', '').size() >= 5);
    }

    // Contenu d'une annonce : titre, description, 15 photos maximum, une vidéo maximum (adresse Cloudinary)
    function validContent(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 2000
        && d.images is list && d.images.size() <= 15
        && (d.video == null
            || (d.video is map && d.video.url is string && d.video.url.matches('https://res\\.cloudinary\\.com/.*')))
        && d.tokens is list && d.tokens.size() <= 60
        && d.pinned is bool;
    }

    // ───────── Annonces ─────────
    match /properties/{id} {
      allow read: if true;

      // Publication : seulement à son nom, avec des compteurs à zéro
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'title', 'description', 'images', 'video', 'likesCount',
             'viewsCount', 'pinned', 'status', 'tokens', 'createdAt', 'updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && notSuspended()
        && publishingOpen()
        && validContent(request.resource.data)
        && request.resource.data.likesCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Modification : l'auteur seulement, et seulement ces champs (jamais l'auteur ni les compteurs)
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'images', 'video', 'tokens', 'updatedAt', 'pinned'])
        && notSuspended()
        && validContent(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);

      // Compteur de « J'aime » : +1 seulement avec la création du « J'aime », -1 seulement avec sa suppression
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        && (
          (request.resource.data.likesCount == resource.data.likesCount + 1
            && !exists(likePath(id, request.auth.uid))
            && existsAfter(likePath(id, request.auth.uid)))
          ||
          (request.resource.data.likesCount == resource.data.likesCount - 1
            && exists(likePath(id, request.auth.uid))
            && !existsAfter(likePath(id, request.auth.uid)))
        );

      // Modération : l'équipe peut masquer / réactiver une annonce (champs status et moderationNote seulement)
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderationNote'])
        && request.resource.data.status in ['active', 'hidden']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationNote'])
            || (request.resource.data.moderationNote is string && request.resource.data.moderationNote.size() <= 300));

      // Compteur de vues : +1 seulement avec l'événement « vue » du jour (un par visiteur et par jour)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
        && request.resource.data.viewsCount == resource.data.viewsCount + 1
        && !exists(eventPath('view_' + request.auth.uid + '_' + id + '_' + dayString(request.time)))
        && existsAfter(eventPath('view_' + request.auth.uid + '_' + id + '_' + dayString(request.time)));

      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isStaff());
    }

    // Un « J'aime » : visible seulement par celui qui l'a donné
    match /properties/{pid}/likes/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId == uid
        && request.resource.data.createdAt == request.time
        && getAfter(propertyPath(pid)).data.likesCount == get(propertyPath(pid)).data.likesCount + 1;
      allow delete: if signedIn()
        && request.auth.uid == uid
        && getAfter(propertyPath(pid)).data.likesCount == get(propertyPath(pid)).data.likesCount - 1;
      allow update: if false;
    }

    // Favoris : privés
    match /favorites/{id} {
      allow get: if signedIn() && id.matches(request.auth.uid + '_.*');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'propertyId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.propertyId is string
        && id == request.auth.uid + '_' + request.resource.data.propertyId
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ───────── Profils ─────────
    match /users/{uid} {
      allow read: if true;

      // Création : uniquement son propre profil, avec des valeurs de départ imposées
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['type', 'name', 'nameLower', 'photoUrl', 'coverUrl', 'bio',
             'followersCount', 'postsCount', 'ratingSum', 'ratingCount', 'verified', 'createdAt'])
        && request.resource.data.type in ['particulier', 'agence']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.nameLower is string
        && request.resource.data.photoUrl == ''
        && request.resource.data.coverUrl == ''
        && request.resource.data.bio == ''
        && request.resource.data.followersCount == 0
        && request.resource.data.postsCount == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.verified == false
        && request.resource.data.createdAt == request.time;

      // Modification de son propre profil : seulement ces champs
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['photoUrl', 'coverUrl', 'bio', 'description', 'phone', 'contactEmail', 'address', 'website', 'hours', 'lastSeen',
                       'showStatus', 'messagesFrom', 'discoverable'])
        && optMatch('photoUrl', 'https://res\\.cloudinary\\.com/.*', 500)
        && optMatch('coverUrl', 'https://res\\.cloudinary\\.com/.*', 500)
        && optMatch('website', 'https?://.*', 200)
        && optStr('bio', 105)
        && optStr('description', 4000)
        && optStr('phone', 30)
        && optStr('contactEmail', 120)
        && optStr('address', 200)
        && optStr('hours', 300)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
            || request.resource.data.lastSeen == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['showStatus'])
            || request.resource.data.showStatus is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['discoverable'])
            || request.resource.data.discoverable is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['messagesFrom'])
            || request.resource.data.messagesFrom in ['everyone', 'following']);

      // Changement de nom (page Confidentialité) : une fois tous les 30 jours, jamais pour un profil vérifié
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.verified == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'nameChangedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.nameChangedAt == request.time
        && (!('nameChangedAt' in resource.data) || request.time > resource.data.nameChangedAt + duration.value(30, 'd'));

      // Compteur d'abonnés d'un profil : +1 seulement avec la création de l'abonnement, -1 seulement avec sa suppression
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          (request.resource.data.followersCount == resource.data.followersCount + 1
            && !exists(followPath(request.auth.uid, uid))
            && existsAfter(followPath(request.auth.uid, uid)))
          ||
          (request.resource.data.followersCount == resource.data.followersCount - 1
            && exists(followPath(request.auth.uid, uid))
            && !existsAfter(followPath(request.auth.uid, uid)))
        );

      // Moyenne des avis : somme et nombre de notes modifiés seulement avec l'avis correspondant
      allow update: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && (
          // nouvel avis
          (!exists(reviewPath(uid, request.auth.uid))
            && existsAfter(reviewPath(uid, request.auth.uid))
            && request.resource.data.ratingCount == resource.data.ratingCount + 1
            && request.resource.data.ratingSum == resource.data.ratingSum + getAfter(reviewPath(uid, request.auth.uid)).data.rating)
          ||
          // note modifiée
          (exists(reviewPath(uid, request.auth.uid))
            && existsAfter(reviewPath(uid, request.auth.uid))
            && request.resource.data.ratingCount == resource.data.ratingCount
            && request.resource.data.ratingSum == resource.data.ratingSum
                 - get(reviewPath(uid, request.auth.uid)).data.rating
                 + getAfter(reviewPath(uid, request.auth.uid)).data.rating)
          ||
          // avis supprimé
          (exists(reviewPath(uid, request.auth.uid))
            && !existsAfter(reviewPath(uid, request.auth.uid))
            && request.resource.data.ratingCount == resource.data.ratingCount - 1
            && request.resource.data.ratingSum == resource.data.ratingSum
                 - get(reviewPath(uid, request.auth.uid)).data.rating)
        );

      // Administration : badge de vérification et suspension
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedUntil', 'verifiedPlan', 'suspended', 'suspendedReason'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspendedReason'])
            || (request.resource.data.suspendedReason is string && request.resource.data.suspendedReason.size() <= 300))
        && (!('verifiedUntil' in request.resource.data) || request.resource.data.verifiedUntil is timestamp)
        && (!('verifiedPlan' in request.resource.data) || request.resource.data.verifiedPlan in ['m1', 'm3', 'y1']);

      // Fin d'un badge : son titulaire (ou l'application à son ouverture) peut le retirer seulement si la date de fin est passée
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified'])
        && request.resource.data.verified == false
        && 'verifiedUntil' in resource.data
        && resource.data.verifiedUntil < request.time;

      // Suppression d'un avis par l'équipe : la note disparaît du total
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount == resource.data.ratingCount - 1;

      // Suppression de son propre compte (page Confidentialité)
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ───────── Abonnements ─────────
    match /follows/{id} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.keys().hasOnly(['followerId', 'targetId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && id == request.resource.data.followerId + '_' + request.resource.data.targetId
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.resource.data.targetId)).data.followersCount
             == get(userPath(request.resource.data.targetId)).data.followersCount + 1;

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid
        && getAfter(userPath(resource.data.targetId)).data.followersCount
             == get(userPath(resource.data.targetId)).data.followersCount - 1;

      allow update: if false;
    }

    // ───────── Avis ─────────
    match /reviews/{id} {
      allow read: if true;

      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.keys().hasOnly(['targetId', 'reviewerId', 'rating', 'comment', 'createdAt', 'updatedAt'])
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && id == request.resource.data.targetId + '_' + request.resource.data.reviewerId
        && validRating(request.resource.data.rating)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(userPath(request.resource.data.targetId)).data.ratingCount
             == get(userPath(request.resource.data.targetId)).data.ratingCount + 1
        && getAfter(userPath(request.resource.data.targetId)).data.ratingSum
             == get(userPath(request.resource.data.targetId)).data.ratingSum + request.resource.data.rating;

      allow update: if signedIn()
        && resource.data.reviewerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt'])
        && validRating(request.resource.data.rating)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.updatedAt == request.time
        && getAfter(userPath(resource.data.targetId)).data.ratingCount
             == get(userPath(resource.data.targetId)).data.ratingCount
        && getAfter(userPath(resource.data.targetId)).data.ratingSum
             == get(userPath(resource.data.targetId)).data.ratingSum - resource.data.rating + request.resource.data.rating;

      allow delete: if signedIn()
        && resource.data.reviewerId == request.auth.uid
        && getAfter(userPath(resource.data.targetId)).data.ratingCount
             == get(userPath(resource.data.targetId)).data.ratingCount - 1
        && getAfter(userPath(resource.data.targetId)).data.ratingSum
             == get(userPath(resource.data.targetId)).data.ratingSum - resource.data.rating;

      allow delete: if isStaff();
    }

    // ───────── Conversations (deux participants, identifiant = les deux UID triés)
    match /conversations/{cid} {
      allow get: if signedIn()
        && ((resource == null && cid.matches('.*' + request.auth.uid + '.*'))
            || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && notSuspended()
        && canStartWith(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0])
        && request.resource.data.keys().hasOnly(['members', 'lastMessage', 'unread', 'lastRead', 'lastSent', 'pinnedBy',
             'mutedBy', 'hidden', 'clearedAt', 'typing', 'context', 'createdAt', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.lastMessage.senderId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'unread', 'lastRead', 'lastSent', 'pinnedBy', 'mutedBy', 'hidden', 'clearedAt', 'typing', 'context', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || request.resource.data.lastMessage.senderId == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);

      allow delete: if false;

      // Messages
      match /messages/{mid} {
        allow read: if isMember(cid);

        allow create: if signedIn()
          && request.auth.uid in getAfter(convPath(cid)).data.members
          && notSuspended()
          && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'mediaUrl', 'duration', 'ref', 'fileName', 'fileSize', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'audio', 'file']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.type == 'text'
              ? request.resource.data.text.size() >= 1
              : (request.resource.data.mediaUrl is string
                 && request.resource.data.mediaUrl.matches('https://res\\.cloudinary\\.com/.*')
                 && (request.resource.data.type != 'file'
                     || (request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
                         && request.resource.data.fileSize is number && request.resource.data.fileSize <= 10485760))))
          && request.resource.data.createdAt == request.time
          && !exists(blockPath(otherMember(cid), request.auth.uid))
          && throttleOk(cid);

        allow update: if isMember(cid) && (
          // modifier son propre message texte
          (resource.data.senderId == request.auth.uid
            && resource.data.type == 'text'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt == request.time)
          ||
          // supprimer pour moi (j'ajoute mon identifiant à la liste)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.auth.uid in request.resource.data.deletedFor
            && request.resource.data.deletedFor.size() <= 2)
          ||
          // supprimer pour tout le monde (l'auteur seulement) : le contenu est vidé
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForAll', 'text', 'mediaUrl'])
            && request.resource.data.deletedForAll == true
            && request.resource.data.text == '')
        );

        allow delete: if false;
      }
    }

    // ───────── Contacts bloqués (visibles seulement par celui qui bloque)
    match /blocks/{id} {
      allow get: if signedIn() && id.matches(request.auth.uid + '_.*');
      allow list: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blockerId', 'blockedId', 'createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ───────── Signalements (écriture seule ; la lecture par l'administration arrive à l'étape suivante)
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetUserId', 'reason', 'details', 'evidence', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['profile', 'property', 'conversation']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.reason in ['spam', 'arnaque', 'contenu_inapproprie', 'harcelement', 'faux_profil', 'autre']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.get('evidence', []).size() <= 12
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'handledBy', 'handledAt'])
        && request.resource.data.status in ['open', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.handledBy == request.auth.uid
        && request.resource.data.handledAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['resolution'])
            || (request.resource.data.resolution is string && request.resource.data.resolution.size() <= 500));
      allow delete: if false;
    }

    // ───────── Statistiques : événements (vue d'annonce, visite de profil, nouvelle conversation)
    match /events/{id} {
      allow get, list: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'ownerId', 'viewerId', 'refId', 'createdAt'])
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.refId is string
        && request.resource.data.type in ['view', 'profile', 'conversation']
        && request.resource.data.createdAt == request.time
        && id == request.resource.data.type + '_' + request.auth.uid + '_' + request.resource.data.refId + '_' + dayString(request.time)
        && (request.resource.data.type == 'view'
            ? get(propertyPath(request.resource.data.refId)).data.authorId == request.resource.data.ownerId
            : (request.resource.data.type == 'profile'
               ? request.resource.data.refId == request.resource.data.ownerId
               : getAfter(convPath(request.resource.data.refId)).data.members.hasAll([request.auth.uid, request.resource.data.ownerId])));
      allow update, delete: if false;
    }

    // ───────── Demandes de badge de vérification (liste d'attente)
    match /verificationRequests/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow create: if signedIn()
        && uid == request.auth.uid
        && notSuspended()
        && verificationOpen()
        && request.resource.data.keys().hasOnly(['userId', 'accountType', 'data', 'plan', 'price', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == uid
        && request.resource.data.accountType in ['particulier', 'agence']
        && request.resource.data.accountType == get(userPath(uid)).data.type
        && request.resource.data.plan in ['m1', 'm3', 'y1']
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 1000
        && request.resource.data.status == 'pending'
        && validVerifData(request.resource.data.data, request.resource.data.accountType)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // nouvelle demande après un refus ou un retrait, ou renouvellement d'un badge accordé (les documents restent au dossier)
      allow update: if signedIn()
        && uid == request.auth.uid
        && resource.data.status in ['rejected', 'revoked', 'approved']
        && notSuspended()
        && verificationOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'plan', 'price', 'renewal', 'status', 'updatedAt', 'reviewNote', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['m1', 'm3', 'y1']
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 1000
        && (resource.data.status != 'approved' || request.resource.data.renewal == true)
        && validVerifData(request.resource.data.data, request.resource.data.accountType)
        && request.resource.data.updatedAt == request.time;
      // décision de l'administration (avec la durée accordée)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'grantedPlan', 'grantedUntil', 'renewal'])
        && request.resource.data.status in ['approved', 'rejected', 'revoked']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['grantedPlan']) || request.resource.data.grantedPlan in ['m1', 'm3', 'y1'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewNote'])
            || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 500));
      allow delete: if signedIn() && uid == request.auth.uid && resource.data.status == 'pending' && !resource.data.get('renewal', false);
    }

    // ───────── Équipe d'administration : propriétaire, administrateur, modérateur
    match /admins/{id} {
      allow get: if signedIn() && (id == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow create: if isOwnerRole()
        && request.resource.data.keys().hasOnly(['role', 'createdAt', 'createdBy'])
        && request.resource.data.role in ['owner', 'admin', 'moderator']
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwnerRole()
        && id != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['owner', 'admin', 'moderator'];
      allow delete: if isOwnerRole() && id != request.auth.uid;
    }

    // ───────── Réglages de la plateforme (lecture publique, écriture par le propriétaire)
    match /platformSettings/{id} {
      allow read: if true;
      allow write: if isOwnerRole()
        && id == 'main'
        && request.resource.data.keys().hasOnly(['announcement', 'publishingEnabled', 'verificationOpen', 'badgePrices', 'updatedAt', 'updatedBy'])
        && request.resource.data.publishingEnabled is bool
        && request.resource.data.verificationOpen is bool
        && request.resource.data.announcement is map
        && request.resource.data.announcement.keys().hasOnly(['enabled', 'text'])
        && request.resource.data.announcement.enabled is bool
        && request.resource.data.announcement.text is string
        && request.resource.data.announcement.text.size() <= 200
        && request.resource.data.badgePrices is map
        && request.resource.data.badgePrices.keys().hasOnly(['m1', 'm3', 'y1'])
        && request.resource.data.badgePrices.m1 is number && request.resource.data.badgePrices.m3 is number && request.resource.data.badgePrices.y1 is number
        && request.resource.data.badgePrices.m1 >= 0 && request.resource.data.badgePrices.m1 <= 1000
        && request.resource.data.badgePrices.m3 >= 0 && request.resource.data.badgePrices.m3 <= 1000
        && request.resource.data.badgePrices.y1 >= 0 && request.resource.data.badgePrices.y1 <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // ───────── Journal d'activité de l'administration (on peut écrire et lire, jamais modifier)
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['actorId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500;
      allow update, delete: if false;
    }

    // ───────── Notifications (chacun lit et gère les siennes ; les autres ne peuvent qu'en créer de vérifiables)
    match /notifications/{uid}/items/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'actorId', 'refId', 'title', 'body', 'link', 'read', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 200
        && request.resource.data.refId is string && request.resource.data.refId.size() <= 200
        && request.resource.data.link is string && request.resource.data.link.size() <= 200
        && request.resource.data.link.matches('[a-z0-9-]+\\.html(\\?[A-Za-z0-9=_&%.-]*)?')
        && (
          (request.resource.data.type == 'follow'
            && id == 'follow_' + request.auth.uid
            && existsAfter(followPath(request.auth.uid, uid)))
          ||
          (request.resource.data.type == 'like'
            && id == 'like_' + request.auth.uid + '_' + request.resource.data.refId
            && existsAfter(likePath(request.resource.data.refId, request.auth.uid))
            && get(propertyPath(request.resource.data.refId)).data.authorId == uid)
          ||
          (request.resource.data.type == 'review'
            && id == 'review_' + request.auth.uid
            && existsAfter(reviewPath(uid, request.auth.uid)))
          ||
          (request.resource.data.type in ['moderation', 'verification', 'system'] && isStaff())
        );
      // rappel « votre badge expire bientôt » : créé par le titulaire lui-même, seulement dans les 8 jours avant la fin
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'actorId', 'refId', 'title', 'body', 'link', 'read', 'createdAt'])
        && request.resource.data.type == 'verification'
        && request.resource.data.actorId == uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.link == 'badge.html'
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 200
        && request.resource.data.refId is string && request.resource.data.refId.size() <= 200
        && id.matches('badge_expiry_[0-9]+')
        && 'verifiedUntil' in get(userPath(uid)).data
        && get(userPath(uid)).data.verifiedUntil > request.time
        && get(userPath(uid)).data.verifiedUntil <= request.time + duration.value(8, 'd');
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ───────── Réglages personnels (privés) : accusés de lecture, « écrit… », notifications
    match /userSettings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validPrefs(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ───────── Informations personnelles PRIVÉES (identité, sexe, date de naissance, contact, consentement)
    // Lisibles seulement par le propriétaire et par les administrateurs (jamais par les modérateurs ni les autres utilisateurs).
    match /userPrivate/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['accountType', 'firstName', 'lastName', 'postName', 'gender', 'birthDate', 'loginType', 'loginId', 'email', 'phone', 'searchKeys', 'agencyName', 'consent', 'createdAt', 'updatedAt'])
        && request.resource.data.accountType == getAfter(userPath(uid)).data.type
        && request.resource.data.loginType in ['email', 'phone']
        && request.resource.data.loginId is string && request.resource.data.loginId.size() <= 120
        && validPerson(request.resource.data)
        && request.resource.data.consent.keys().hasOnly(['acceptedAt', 'version'])
        && request.resource.data.consent.acceptedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'postName', 'gender', 'birthDate', 'email', 'phone', 'searchKeys', 'agencyName', 'updatedAt'])
        && validPerson(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (get(userPath(uid)).data.verified == false
            || (request.resource.data.firstName == resource.data.firstName
                && request.resource.data.lastName == resource.data.lastName
                && request.resource.data.postName == resource.data.postName
                && request.resource.data.get('agencyName', '') == resource.data.get('agencyName', '')));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ───────── Recommandations : intérêts appris de chaque compte, et recommandations calculées (privés)
    match /userInterests/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validInterests(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /recommendations/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'properties', 'profiles', 'searches', 'basedOn', 'computedAt'])
        && request.resource.data.properties is list && request.resource.data.properties.size() <= 100
        && request.resource.data.profiles is list && request.resource.data.profiles.size() <= 40
        && request.resource.data.searches is list && request.resource.data.searches.size() <= 20
        && request.resource.data.basedOn is map
        && request.resource.data.computedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
